# Copy to .env and fill in. .env is git-ignored.
# NASA FIRMS map key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# AISStream API key: https://aisstream.io/apikeys
AISSTREAM_API_KEY=
# AlterLab API key (used from M2)
ALTERLAB_API_KEY=
# ReliefWeb API v2 approved appname (enables the reliefweb collector; request one at
# https://apidoc.reliefweb.int/parameters#appname)
RELIEFWEB_APPNAME=
# Cesium ion access token (terrain/imagery; optional): https://ion.cesium.com/signup/
CESIUM_ION_TOKEN=
# Optional overrides
# OSINT_DATA_DIR=./data
# OSINT_CONFIG_DIR=./config
# OSINT_HOST=127.0.0.1
# OSINT_PORT=8765
# Binding to a non-loopback host requires an API token; clients then send
# "Authorization: Bearer <token>" (or ?token=<token> for KML / WebSocket).
# OSINT_API_TOKEN=
# Extra Host header values to accept besides 127.0.0.1/localhost/::1 (comma separated)
# OSINT_ALLOWED_HOSTS=
